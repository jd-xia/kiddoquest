# Copy to .env next to docker-compose.yml to override the local defaults.
# Both services must use the same AUTH_JWT_SECRET (at least 32 bytes).

AUTH_JWT_SECRET=local-dev-only-not-for-production-32b
AUTH_JWT_TTL=PT12H

# Public Google OAuth client id. Also put this in common/cloud-config.js.
GOOGLE_CLIENT_ID=669511875089-psnjdrjcfl3v8pc7kktm11bu8a3aau7p.apps.googleusercontent.com

# MySQL root password. Set once, on the first start of the mysql volume.
MYSQL_ROOT_PASSWORD=kiddoquest-local
