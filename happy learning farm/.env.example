# Copy to .env next to docker-compose.yml to override the local defaults.
# Both services must use the same AUTH_JWT_SECRET (at least 32 bytes).

AUTH_JWT_SECRET=local-dev-only-not-for-production-32b
AUTH_JWT_TTL=PT12H

# Google OAuth client id. Put the same value in frontend/common/cloud-config.local.js.
# That file is gitignored. Do not put the id in cloud-config.js.
GOOGLE_CLIENT_ID=

# MySQL root password. The mysql volume keeps this password after the first start.
MYSQL_ROOT_PASSWORD=kiddoquest-local
