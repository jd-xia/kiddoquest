# Copy to .env only as a reminder. This service reads the process environment,
# not the file. Do not commit a real .env.

# At least 32 bytes. Use the same value in backend-data.
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Public Google OAuth client id (OIDC). No client secret is used.
# Create a Web client in Google Cloud Console and add
# http://localhost:8000 as an Authorized JavaScript origin.
GOOGLE_CLIENT_ID=

AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=kiddoquest
AUTH_JWT_TTL=PT12H

# Optional MySQL profile: --spring.profiles.active=mysql
# OPENID_DB_URL=jdbc:mysql://localhost:3306/kiddoquest_openid?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# OPENID_DB_USERNAME=kiddoquest
# OPENID_DB_PASSWORD=change-me
